# General
NODE_ENV=development

# Database (PostgreSQL + pgvector)
POSTGRES_DB=autoengineer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pass
DATABASE_URL=postgres://postgres:postgres_dev_pass@localhost:5432/autoengineer

# Caching & Event Bus (Redis)
REDIS_URL=redis://localhost:6379/0

# Django Backend
DJANGO_SECRET_KEY=django-insecure-secret-key-change-in-production
BACKEND_PORT=8000
JWT_SECRET=jwt-super-secret-key

# FastAPI AI Service
AI_SERVICE_PORT=8001
SERVICE_SECRET=internal-service-to-service-auth-secret
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Integrations
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
JIRA_API_TOKEN=
LINEAR_API_KEY=
